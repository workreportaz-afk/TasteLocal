# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit the actual .env file -- it's in .gitignore.

# MySQL
DB_NAME=tastelocal_db
DB_USER=tastelocal
DB_PASSWORD=change_me_dev_password
DB_ROOT_PASSWORD=change_me_root_password

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Frontend URL, for the backend's root landing page link
# (Dev: leave as the Vite dev server. Prod: set to "/" since nginx serves both together.)
FRONTEND_URL=http://localhost:5173

# Production only (docker-compose.prod.yml) -- your real domain(s)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
